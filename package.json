{
  "name": "nvisage-3d-installation-planner",
  "private": true,
  "version": "0.1.0-dev",
  "type": "module",
  "description": "NVISAGE 3D Installation Planner — plan a golf simulator room with NVISAGE launch monitors.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/verify-no-private-assets.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:dist": "node scripts/verify-no-private-assets.mjs",
    "verify:specs": "python scripts/verify_spec_sources.py",
    "deploy": "node scripts/deploy-pages.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "pretendard": "^1.3.9",
    "react": "19.2",
    "react-dom": "19.2",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64",
    "@types/node": "^26.6.4",
    "@types/react": "19.2",
    "@types/react-dom": "19.2",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "typescript": "5.9",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
